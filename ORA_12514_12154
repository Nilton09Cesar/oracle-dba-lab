-- 2. Criar o PDB (OMF cuida dos datafiles)
CREATE PLUGGABLE DATABASE PDBTNS 
ADMIN USER pdb_admin IDENTIFIED BY senha;

-- 3. Abrir e Salvar o estado do PDBTNS
ALTER PLUGGABLE DATABASE PDBTNS OPEN;
ALTER PLUGGABLE DATABASE PDBTNS SAVE STATE;

-- 4. Mudar para o contexto do PDB
ALTER SESSION SET CONTAINER = PDBTNS;

-- 5. Criar usuário e dar grant
CREATE USER usr_int IDENTIFIED BY senha;
GRANT CREATE SESSION TO usr_int;

-- 6. Confirmar serviço registrado no listener
